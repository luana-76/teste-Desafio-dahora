# Banco de dados (SQLite local para desenvolvimento)
DATABASE_URL="file:./dev.db"

# Servidor
PORT=3333

# Origem(ns) permitida(s) para CORS (frontend). Pode ser mais de uma,
# separadas por vírgula. Troque 192.168.0.10 pelo IP local da máquina
# que vai rodar o backend (veja instruções de como descobrir o IP).
CORS_ORIGIN="http://localhost:5173,http://192.168.0.10:5173"
